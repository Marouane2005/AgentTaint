# AgentTaint environment. `agenttaint init` writes a real .env (mode 600) with
# generated values; this file only documents the keys. Never commit a real .env.
#
# Generate a value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# HMAC key binding approvals to exact arguments (32+ chars, required).
AGENTTAINT_CONFIRM_SECRET=
# Dashboard read token (typed into the UI once per tab).
AGENTTAINT_DASHBOARD_TOKEN=
# Separate token for approving confirmations in the dashboard. Must differ.
AGENTTAINT_APPROVER_TOKEN=
# Password for the bundled Postgres container (docker compose).
POSTGRES_PASSWORD=

# Storage. SQLite for one machine; compose sets Postgres URLs itself.
AGENTTAINT_DATABASE_URL=sqlite+pysqlite:////var/lib/agenttaint/agenttaint.db
AGENTTAINT_SECURITY_DB_URL=sqlite+pysqlite:////var/lib/agenttaint/agenttaint-security.db
