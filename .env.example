# Local-first defaults. No paid API keys required.
AGENTTAINT_DATABASE_URL=sqlite+pysqlite:///./agenttaint.db
AGENTTAINT_SECURITY_DB_URL=sqlite+pysqlite:///./agenttaint-security.db
# Optional Postgres (see docker-compose.yml):
# AGENTTAINT_DATABASE_URL=postgresql+psycopg://agenttaint:agenttaint@127.0.0.1:5432/agenttaint
# AGENTTAINT_SECURITY_DB_URL=postgresql+psycopg://agenttaint:agenttaint@127.0.0.1:5432/agenttaint
AGENTTAINT_TRUST_REGISTRY_PATH=policies/trust_registry.yaml
AGENTTAINT_RETAIN_REDACTED_CONTENT=true
AGENTTAINT_SHARED_SECRET=dev-only-change-me
AGENTTAINT_API_HOST=127.0.0.1
AGENTTAINT_API_PORT=8080
# Control plane auth: off | mutations | required (default required when token set)
# AGENTTAINT_API_AUTH=required
# AGENTTAINT_DASHBOARD_TOKEN=change-me
AGENTTAINT_CONFIRM_SECRET=agenttaint-local-confirm-secret-change-me
